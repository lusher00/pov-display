# Waveshare ESP32-S3-Zero (ESP32-S3FH4R2: 4 MB flash, 2 MB quad PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
# console and REPL on the S3's native USB port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# the column output task owns core 1; only core 0's idle task is watched
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# app with WiFi is ~1 MB: use the 1.5 MB single-app partition table
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
